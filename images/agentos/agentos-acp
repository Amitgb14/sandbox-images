#!/opt/agentos/venv/bin/python
"""agentos-acp: an agent, spoken to over the Agent Client Protocol (ACP) on
stdin and stdout, for Studio, an editor or any other ACP client outside the
sandbox. The client starts it through the sandbox API, which carries stdio:

    sandbox-cli exec <sandbox> -- agentos-acp [--agent claude|gemini|opencode|codex]

Each agent is the image's own, with the same settings, MCP servers and
instructions as `sandbox-cli agent <name>` (/etc/agentos/manifest.json lists
them), and the login `sandbox-cli agent <name> --keep ...` restored into HOME:

  claude    the ACP project's Claude Code adapter, on the image's Claude Code
  gemini    Gemini CLI's own ACP mode, auto-approving (--yolo)
  opencode  opencode's own ACP mode
  codex     the ACP project's Codex adapter, on the image's Codex

Between the client and the agent, this relays every message unchanged but
two things in a new or loaded session, each of which would otherwise fail:

  - the client's MCP servers are dropped. The image's are the agent's own; a
    client's stdio servers are programs on the client's machine, which are
    not here; and Claude Code refuses a session that offers more than its
    managed list.
  - a working directory that does not exist in the sandbox (the client's
    own project path, as an editor sends) becomes HOME.

Each is said on stderr. stdout is the protocol: nothing else is written to it.
"""
import json
import os
import subprocess
import sys
import threading

ACP = "/opt/agentos/acp/node_modules/@agentclientprotocol"

# Each agent: the command that speaks ACP, what it adds to the environment,
# the login file sandbox-cli restores and the keys that stand in for one.
AGENTS = {
    "claude": {
        "argv": ["node", f"{ACP}/claude-agent-acp/dist/index.js"],
        "env": {"CLAUDE_CODE_EXECUTABLE": "/usr/local/bin/claude"},
        "login": [".claude/.credentials.json"],
        "keys": ["ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN"],
    },
    "gemini": {
        # YOLO can only be asked for on the command line, not in settings.
        "argv": ["gemini", "--acp", "--yolo"],
        "env": {},
        "login": [".gemini/oauth_creds.json"],
        "keys": ["GEMINI_API_KEY", "GOOGLE_API_KEY", "GOOGLE_GENAI_USE_VERTEXAI"],
    },
    "opencode": {
        "argv": ["opencode", "acp"],
        "env": {},
        "login": [".local/share/opencode/auth.json"],
        "keys": ["ANTHROPIC_API_KEY", "OPENAI_API_KEY", "GEMINI_API_KEY", "OPENROUTER_API_KEY", "GROQ_API_KEY"],
    },
    "codex": {
        "argv": ["node", f"{ACP}/codex-acp/dist/index.js"],
        # The image's codex, not a second copy; no prompts, as the image's
        # other agents; and no browser login, which a sandbox cannot open.
        "env": {"CODEX_PATH": "/usr/local/bin/codex", "INITIAL_AGENT_MODE": "agent-full-access", "NO_BROWSER": "1"},
        "login": [".codex/auth.json"],
        "keys": ["CODEX_API_KEY", "OPENAI_API_KEY"],
    },
}
SESSION_METHODS = ("session/new", "session/load", "session/resume", "session/fork")


def log(msg):
    print(f"agentos-acp: {msg}", file=sys.stderr, flush=True)


def adjust(msg):
    """The client's session request, made one this sandbox can open."""
    params = msg.get("params")
    if msg.get("method") not in SESSION_METHODS or not isinstance(params, dict):
        return msg
    servers = params.get("mcpServers") or []
    if servers:
        log("dropped the client's MCP servers (the image's own are used): "
            + ", ".join(str(s.get("name")) for s in servers))
        params["mcpServers"] = []
    cwd = params.get("cwd")
    if isinstance(cwd, str) and not os.path.isdir(cwd):
        log(f"working directory {cwd!r} is not in this sandbox; using {os.environ['HOME']}")
        params["cwd"] = os.environ["HOME"]
    return msg


def main():
    args = sys.argv[1:]
    name = "claude"
    if args[:1] == ["--agent"] and len(args) > 1:
        name, args = args[1], args[2:]
    elif args[:1] and args[0].startswith("--agent="):
        name, args = args[0].split("=", 1)[1], args[1:]
    spec = AGENTS.get(name)
    if spec is None:
        log(f"no agent {name!r}; this image has {', '.join(AGENTS)}")
        sys.exit(2)
    home = os.environ.get("HOME", "/sandbox/home")
    logged_in = any(os.path.isfile(p) and os.path.getsize(p) > 0
                    for p in (os.path.join(home, f) for f in spec["login"]))
    if not logged_in and not any(os.environ.get(k) for k in spec["keys"]):
        log(f"no {name} login in this sandbox; make one with "
            f"'sandbox-cli agent {name} --keep --name <name> --image ... -- --version', "
            f"or log in from a shell in the sandbox")
    env = dict(os.environ, **spec["env"])
    agent = subprocess.Popen([*spec["argv"], *args], cwd=home, env=env,
                             stdin=subprocess.PIPE, stdout=subprocess.PIPE, bufsize=0)

    def to_client():
        # The adapter's messages go back exactly as they came.
        for line in agent.stdout:
            sys.stdout.buffer.write(line)
            sys.stdout.buffer.flush()

    out = threading.Thread(target=to_client, daemon=True)
    out.start()
    try:
        for line in sys.stdin.buffer:
            try:
                msg = json.loads(line)
            except ValueError:
                agent.stdin.write(line)
            else:
                if isinstance(msg, dict) and msg.get("method") in SESSION_METHODS:
                    line = (json.dumps(adjust(msg)) + "\n").encode()
                agent.stdin.write(line)
            agent.stdin.flush()
    except (BrokenPipeError, KeyboardInterrupt):
        pass
    finally:
        try:
            agent.stdin.close()
        except BrokenPipeError:
            pass
    out.join()
    sys.exit(agent.wait())


if __name__ == "__main__":
    main()
