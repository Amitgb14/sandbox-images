#!/bin/sh
# sandbox-desktop: a desktop in this sandbox, served over VNC on the guest's
# own loopback. Run it in the background (Studio's Desktop tab does); it stays
# in the foreground as the display, so stopping it stops the desktop.
#
# This replaces the desktop image's script of the same name, with the same
# variables and the same port, so whatever starts that one starts this.
#
#   SANDBOX_DESKTOP_SIZE      the screen, WxHxDEPTH (default 1280x800x24)
#   SANDBOX_DESKTOP_PORT      the VNC port on 127.0.0.1 (default 5900)
#   SANDBOX_DESKTOP_SESSION   xfce (default) or openbox, the desktop image's
#                             window manager, terminal and browser
#   SANDBOX_DESKTOP_GPU       auto (default): OpenGL draws on the sandbox's GPU
#                             when it has one that answers, and in software
#                             otherwise; on: the GPU, or the desktop does not
#                             start; off: software
#
# With the GPU, the session runs through VirtualGL: OpenGL is drawn on the
# card through its EGL driver and each frame is put on this display, so
# everything else here is the same. The renderer in use is written to
# $XDG_RUNTIME_DIR/sandbox-desktop.gl.
set -eu

display=:1
size=${SANDBOX_DESKTOP_SIZE:-1280x800x24}
port=${SANDBOX_DESKTOP_PORT:-5900}
session=${SANDBOX_DESKTOP_SESSION:-xfce}
gpu=${SANDBOX_DESKTOP_GPU:-auto}
export DISPLAY=$display

case $session in
  xfce|openbox) ;;
  *) echo "sandbox-desktop: SANDBOX_DESKTOP_SESSION is xfce or openbox, not '$session'" >&2; exit 2 ;;
esac
case $gpu in
  auto|on|off) ;;
  *) echo "sandbox-desktop: SANDBOX_DESKTOP_GPU is auto, on or off, not '$gpu'" >&2; exit 2 ;;
esac

geometry=${size%x*}
depth=${size##*x}
case $geometry in
  *x*) ;;
  *) echo "sandbox-desktop: SANDBOX_DESKTOP_SIZE is WxHxDEPTH, not '$size'" >&2; exit 2 ;;
esac

# A runtime directory of the user's own: the session bus, the portals and
# Flatpak keep their sockets there. The guest has no login manager to make one.
: "${XDG_RUNTIME_DIR:=/tmp/runtime-$(id -u)}"
export XDG_RUNTIME_DIR
mkdir -p -m 0700 "$XDG_RUNTIME_DIR"

# Flatpak: the user's own installation, in HOME, so what they install lives
# with their work. Adding Flathub reads the description kept in the image, so
# it needs no network; installing from it does.
if command -v flatpak >/dev/null 2>&1; then
  flatpak remote-add --user --if-not-exists flathub \
    /usr/share/sandbox-workstation/flathub.flatpakrepo >/dev/null 2>&1 || true
fi
# Apps from either installation appear in the menu. (Debian sets this in a
# login shell's profile; nothing here is a login shell.)
XDG_DATA_DIRS="$HOME/.local/share/flatpak/exports/share:/var/lib/flatpak/exports/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export XDG_DATA_DIRS
# The guest has no /dev/fuse, so an AppImage cannot mount itself: it unpacks
# to a temporary directory and runs from there instead.
export APPIMAGE_EXTRACT_AND_RUN=1

# One start at a time. Studio's Desktop tab runs this whenever it connects,
# and an agent's tools may start it too; without the lock, two starts would
# both find no display, and the one whose Xvnc lost would go on to start a
# second session on the winner's display. Nothing started below keeps the
# lock (9>&-): it is let go once the desktop is up.
exec 9>"/tmp/sandbox-desktop-$(id -u).lock"
flock 9

# A stale lock from a desktop that was killed would keep the display from
# starting again.
if [ -e /tmp/.X1-lock ] && ! kill -0 "$(tr -d ' ' </tmp/.X1-lock)" 2>/dev/null; then
  rm -f /tmp/.X1-lock /tmp/.X11-unix/X1
fi

# A desktop is already up: show that one rather than start another. This
# stays in the foreground while that display lives, as it would had it
# started it, so whatever waits on it still can.
if [ -e /tmp/.X1-lock ]; then
  running=$(tr -d ' ' </tmp/.X1-lock)
  echo "sandbox-desktop: a desktop is already running on $display" >&2
  exec 9>&-
  while kill -0 "$running" 2>/dev/null; do sleep 1; done
  exit 0
fi

# The display and the VNC server in one. On loopback only and with no
# password: the only way to it is the API's tunnel, which only a caller allowed
# to use this sandbox can open. -nolisten tcp: X itself is reached through its
# unix socket only. -AlwaysShared lets a second viewer join rather than cut off
# the first. -AcceptSetDesktopSize lets a viewer resize the screen to fit.
Xvnc "$display" \
  -geometry "$geometry" -depth "$depth" \
  -rfbport "$port" -localhost -interface 127.0.0.1 \
  -SecurityTypes None -AlwaysShared -AcceptSetDesktopSize \
  -nolisten tcp -desktop sandbox 9>&- &
xvnc=$!
# Stopping this script stops the desktop, even when the signal reaches this
# script alone rather than its whole process group.
trap 'kill "$xvnc" 2>/dev/null; exit 143' TERM INT HUP

i=0
# The display answering is only ours while our Xvnc is alive.
until kill -0 "$xvnc" 2>/dev/null && xdpyinfo >/dev/null 2>&1; do
  kill -0 "$xvnc" 2>/dev/null || { echo "sandbox-desktop: the display exited" >&2; exit 1; }
  i=$((i + 1))
  [ "$i" -lt 100 ] || { echo "sandbox-desktop: the display did not start" >&2; exit 1; }
  sleep 0.1
done

# The GPU: the renderer VirtualGL gets from the card's EGL driver, asked on
# this display. A sandbox without a GPU has no /dev/nvidiactl; one whose
# driver does not answer gets software rather than no desktop, unless the GPU
# was asked for.
vgl=/opt/VirtualGL/bin
renderer=
if [ "$gpu" != off ] && [ -e /dev/nvidiactl ] && [ -x "$vgl/vglrun" ]; then
  renderer=$(VGL_DISPLAY=egl timeout 30 "$vgl/vglrun" "$vgl/glxinfo" -B 9>&- 2>/dev/null |
    sed -n 's/^OpenGL renderer string: //p') || true
  case $renderer in
    *llvmpipe*|*softpipe*) renderer= ;;
  esac
fi
run=
if [ -n "$renderer" ]; then
  # +wm: the window manager runs through it too, as TurboVNC's -vgl does.
  export VGL_DISPLAY=egl
  run="$vgl/vglrun +wm"
  echo "sandbox-desktop: OpenGL draws on the GPU: $renderer" >&2
elif [ "$gpu" = on ]; then
  echo "sandbox-desktop: SANDBOX_DESKTOP_GPU=on, but no GPU answers (is this a sandbox made with --gpus?)" >&2
  kill "$xvnc" 2>/dev/null
  exit 1
else
  renderer=$("$vgl/glxinfo" -B 2>/dev/null | sed -n 's/^OpenGL renderer string: //p') || true
fi
printf '%s\n' "${renderer:-unknown}" >"$XDG_RUNTIME_DIR/sandbox-desktop.gl"

case $session in
  xfce)
    xdg-user-dirs-update >/dev/null 2>&1 || true
    $run dbus-launch --exit-with-session startxfce4 >/dev/null 2>&1 9>&- &
    ;;
  openbox)
    $run openbox 9>&- &
    $run xterm -geometry 100x30+40+40 9>&- &
    $run chromium --new-window "about:blank" >/dev/null 2>&1 9>&- &
    ;;
esac
exec 9>&-

# The display is what this script is: when it goes, the desktop goes.
wait "$xvnc"
